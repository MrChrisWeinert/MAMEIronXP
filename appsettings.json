{
  "MAME": {
    "Directory": "/opt/homebrew/bin",
    "Executable": "mame",
    "Args": "-autosave -skip_gameinfo -video bgfx",
    "LogFile": "/Users/chrisweinert/MAME/MAMEIronXP.log",
    "SnapDirectory": "/Users/chrisweinert/MAME/snap"
  },
  "GameFilter": {
    "//": "Games are excluded from games.json based on catver.ini's Category/SubCategory and MAME's description. Remove this whole 'GameFilter' section to fall back to MAMEIronXP's built-in default filter list.",
    "ExcludedCategories": [
      "Electromechanical",
      "Casino",
      "Home Systems",
      "Professional Systems",
      "System",
      "Ball & Paddle",
      "Multiplay",
      "Quiz",
      "Utilities",
      "Handheld",
      "Computer",
      "Game Console",
      "Slot Machine",
      "Misc.",
      "Tabletop",
      "Board Game",
      "Gambling",
      "Calculator"
    ],
    "ExcludedSubCategories": [ "Reels", "Mahjong" ],
    "ExcludedCategoryContains": [ "* Mature *" ],
    "ExcludedSubCategoryContains": [ "* Mature *" ],
    "ExcludedDescriptionContains": [ "DECO Cassette", "PlayChoice-10", "bootleg" ],
    "ExcludedCategorySubCategoryPairs": [
      { "Category": "Rhythm", "SubCategories": [ "Dance", "Instruments" ] }
    ]
  },
  "CloudSync": {
    "//": "When Enabled is true, user-data.json is automatically uploaded to the cloud (Endpoint) every time it changes. UserId is generated and stored here automatically the first time it's needed.",
    "Enabled": true,
    "Endpoint": "",
    "UserId": ""
  }
}
